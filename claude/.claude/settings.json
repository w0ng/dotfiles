{
  "permissions": {
    "deny": [
      "Skill(mattpocock-skills:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/andrew/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "lua-lsp@claude-plugins-official": true,
    "mattpocock-skills@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "voice": {
    "enabled": false,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "editorMode": "vim",
  "voiceEnabled": false,
  "agentPushNotifEnabled": true,
  "inputNeededNotifEnabled": true,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.zsh",
    "refreshInterval": 60
  }
}
