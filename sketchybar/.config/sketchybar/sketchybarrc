#!/bin/bash
#
# sketchybar: status bar for AeroSpace.
#
# Everything on the left is driven by AeroSpace callbacks declared in
# aerospace/.config/aerospace/aerospace.toml; nothing polls but the clock and
# the battery.

CONFIG_DIR="$HOME/.config/sketchybar"
PLUGIN_DIR="$CONFIG_DIR/plugins"

source "$CONFIG_DIR/colors.sh"

# One Nerd Font (Maple Mono NL NF CN, widest coverage installed here at 33k
# codepoints) for both text and icons, so glyphs and label text always match.
LABEL_FONT="Maple Mono NL NF CN"
ICON_FONT="Maple Mono NL NF CN"
# Single source for the text size, so the declarations below cannot drift apart.
FONT_SIZE="16.0"

# ── bar ──────────────────────────────────────────────────────────────────────

sketchybar --bar \
  position=top \
  height=32 \
  blur_radius=20 \
  color="$BLACK" \
  padding_left=6 \
  padding_right=6

# ── defaults applied to every item ───────────────────────────────────────────

sketchybar --default \
  icon.font="$ICON_FONT:ExtraBold:$FONT_SIZE" \
  label.font="$LABEL_FONT:Medium:$FONT_SIZE" \
  icon.color="$FG" \
  label.color="$FG" \
  icon.padding_left=8 \
  icon.padding_right=4 \
  label.padding_left=4 \
  label.padding_right=8 \
  background.corner_radius=6 \
  background.height=25 \
  padding_left=2 \
  padding_right=2

# ── AeroSpace items (left) ───────────────────────────────────────────────────

# Custom events must be registered before anything can subscribe to them.
sketchybar --add event aerospace_change

# Draws nothing; it only carries the script for every AeroSpace-derived item.
# sketchybar runs a script once per subscribed event and once per item on
# --update, so a second carrier would repaint the whole set again for nothing.
#
# AeroSpace has no layout-change callback, so the layout keybindings fire
# aerospace_change by hand. on-mode-changed, on-focus-changed and
# exec-on-workspace-change fire it too.
#
# This deliberately does not subscribe front_app_switched, which cannot see
# focus moving between two windows of the same app, nor focus changes that
# originate outside AeroSpace (`open -a`). aerospace_change sees both.
#
# display_change catches monitors being plugged or unplugged, which makes
# AeroSpace redistribute workspaces without firing an event of its own.
sketchybar --add item aerospace_driver left \
  --subscribe aerospace_driver aerospace_change display_change \
  --set aerospace_driver \
  drawing=off \
  script="$PLUGIN_DIR/aerospace.sh"

# Binding-mode indicator, hidden unless a non-main mode is active.
sketchybar --add item mode left \
  --set mode \
  icon.drawing=off \
  label.padding_left=10 \
  label.padding_right=10 \
  drawing=off

# The ten workspaces, mirroring persistent-workspaces in aerospace.toml. They
# stay literal rather than read from `aerospace list-workspaces`, because
# deriving them would leave a bar reload with no pills at all whenever AeroSpace
# is down. The same ten are already spelled out by the alt-N, alt-shift-N and
# alt-ctrl-shift-N keybindings there, which TOML cannot generate either way.
SPACES=(1 2 3 4 5 6 7 8 9 0)

# The pills carry no script of their own: aerospace.sh paints the whole row in
# one pass, avoiding ten script spawns per workspace switch.
for sid in "${SPACES[@]}"; do
  sketchybar --add item "space.$sid" left \
    --set "space.$sid" \
    label="$sid" \
    icon.drawing=off \
    label.padding_left=10 \
    label.padding_right=10 \
    click_script="aerospace workspace $sid"
done

# ── monitor + layout (left, after workspaces) ────────────────────────────────
# aerospace.sh paints both, so neither carries a script or a subscription of
# its own.
sketchybar --add item monitor left \
  --set monitor \
  padding_left=12 \
  background.color="$BAR" \
  background.drawing=on \
  click_script="aerospace move-workspace-to-monitor --wrap-around next; sketchybar --trigger aerospace_change"

sketchybar --add item layout left \
  --set layout \
  padding_left=6 \
  background.color="$BAR" \
  background.drawing=on \
  click_script="aerospace fullscreen; sketchybar --trigger aerospace_change"

# ── front app (left, after the layout indicator) ─────────────────────────────

sketchybar --add item front_app left \
  --subscribe front_app front_app_switched \
  --set front_app \
  icon.drawing=off \
  label.color="$YELLOW" \
  label.font="$LABEL_FONT:Bold:$FONT_SIZE" \
  padding_left=12 \
  script="$PLUGIN_DIR/front_app.sh"

# ── right side ───────────────────────────────────────────────────────────────

sketchybar --add item clock right \
  --set clock \
  update_freq=10 \
  icon="󰅐" \
  icon.color="$BLUE" \
  script="$PLUGIN_DIR/clock.sh"

sketchybar --add item battery right \
  --subscribe battery power_source_change system_woke \
  --set battery \
  update_freq=120 \
  script="$PLUGIN_DIR/battery.sh"

sketchybar --add item wifi right \
  --subscribe wifi wifi_change system_woke \
  --set wifi \
  script="$PLUGIN_DIR/wifi.sh"

sketchybar --add item volume right \
  --subscribe volume volume_change \
  --set volume \
  script="$PLUGIN_DIR/volume.sh"

# ── go ───────────────────────────────────────────────────────────────────────

# --update runs every item's script, which is what performs the initial paint.
sketchybar --update
