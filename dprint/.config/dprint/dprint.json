{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "incremental": true,
  "lineWidth": 100,
  "indentWidth": 2,
  "typescript": {
    "quoteStyle": "preferSingle"
  },
  "json": {},
  "markdown": {},
  "includes": [
    "**/*.{ts,tsx,js,jsx,cjs,mjs,json,md}"
  ],
  "excludes": [
    "**/node_modules",
    "**/*-lock.json"
  ],
  "plugins": [
    "npm:@dprint/typescript@0.96.1",
    "npm:@dprint/json@0.23.0",
    "npm:@dprint/markdown@0.23.3"
  ]
}
